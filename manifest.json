{
  "manifest_version": 3,
  "name": "Gemini AI Translator",
  "version": "1.0.0",
  "description": "Smart, context-aware AI translator powered by Google Gemini with professional Georgian localization.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini AI Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Command+Shift+T"
      },
      "description": "Translate selected text with Gemini AI"
    },
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Translate full webpage with Gemini AI"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content.css", "lib/*", "reader.html", "reader.css", "reader.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
